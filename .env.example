# Copie este arquivo para .env e preencha os valores:
#
#   cp .env.example .env
#
# O .env esta no .gitignore: ele guarda SEGREDOS e nunca vai para o GitHub.

# Login no Jenkins (http://localhost:8080)
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=troque-esta-senha

# Repositorio que o Jenkins vai acompanhar
GITHUB_REPO_URL=https://github.com/henrique-pizzoni/exemplo.git

# Usuario e token do GitHub
# Token: GitHub -> Settings -> Developer settings -> Personal access tokens
#        Fine-grained, acesso so a este repositorio, permissao "Contents: Read"
GITHUB_USER=seu-usuario
GITHUB_TOKEN=github_pat_xxxxxxxx

# Deploy Hook do Render (Settings -> Deploy Hook)
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxxx?key=yyyy
